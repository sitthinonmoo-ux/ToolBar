{
  "name": "toolbar",
  "productName": "ToolBar",
  "version": "0.1.8",
  "description": "Game utility toolbox — ReShade installer, FiveM maintenance, and more via a plugin/card system.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "predist": "npm run clean",
    "dist": "electron-builder",
    "prerelease": "npm run clean",
    "release": "electron-builder --publish always"
  },
  "author": "sitthinonmoo",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/sitthinonmoo-ux/toolbar.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.novaassist.toolbar",
    "productName": "ToolBar",
    "icon": "icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "plugins/**/*",
      "presets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "sitthinonmoo-ux",
      "repo": "toolbar"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
