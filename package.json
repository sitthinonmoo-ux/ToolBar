{
  "name": "toolbar",
  "productName": "ToolBar",
  "version": "0.1.0",
  "description": "Game utility toolbox — ReShade installer, FiveM maintenance, and more via a plugin/card system.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "sitthinonmoo",
  "license": "UNLICENSED",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.novaassist.toolbar",
    "productName": "ToolBar",
    "icon": "icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "plugins/**/*",
      "presets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
